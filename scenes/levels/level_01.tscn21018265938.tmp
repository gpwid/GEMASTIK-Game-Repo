[sub_resource type="Resource" id="Resource_tyxjt"]
script = ExtResource("10_tyxjt")
title = "Supply Hub"
description = "The heart of the system. Suplai tidak akan muncul tanpa sebuah supply hub. Tarik mouse dari bangunan ini menuju Transit Hub atau Desa."
target_group = &"tutorial_supply_hub"
world_highlight_size = Vector2(190, 170)
metadata/_custom_type_script = "uid://cfeuvjn2rolxk"

[sub_resource type="Resource" id="Resource_07lms"]
script = ExtResource("10_tyxjt")
title = "Transit Hub"
description = "Transit Hub menghubungkan perjalanan darat dan laut. Pelabuhan memungkinkan ekspedisi berganti dari truk menjadi kapal. Gunakan ini ketika jangkauan kendaraan mu tidak sampai atau ingin mengirim suplai keluar pulau!"
target_group = &"tutorial_transit_hub"
world_highlight_size = Vector2(170, 170)
metadata/_custom_type_script = "uid://cfeuvjn2rolxk"

[sub_resource type="Resource" id="Resource_gi8m4"]
script = ExtResource("10_tyxjt")
title = "Kebutuhan Desa"
description = "Akhiri rute di desa. Ikon di samping desa menunjukkan kebutuhan mereka dari bahan pangan, medis, dan infrastruktur. Jika permintaan di anggurin, maka desa akan memasuki fase krisis yang bisa menuju ke kehancuran desa tersebut.
"
target_group = &"tutorial_village"
world_highlight_size = Vector2(190, 170)
metadata/_custom_type_script = "uid://cfeuvjn2rolxk"

[sub_resource type="Resource" id="Resource_3g50r"]
script = ExtResource("10_tyxjt")
title = "Mulai Ekspedisi"
description = "Rute masih kosong setelah dibuat. Tarik icon pemimpin ekspedisi dari panel kanan ke garis rute yang di inginkan untuk memulai perjalanan!"
target_group = &"tutorial_leader_roster"
world_highlight_size = Vector2(190, 170)
metadata/_custom_type_script = "uid://cfeuvjn2rolxk"

